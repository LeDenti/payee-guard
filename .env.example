# Copy to .env.local (ignored by git) and fill in from the Firebase console:
# Project settings > General > Your apps > Web app > SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# App Check (required by Firebase AI Logic): reCAPTCHA Enterprise site key for the hosted app.
VITE_RECAPTCHA_SITE_KEY=
# Optional: a fixed App Check debug token for localhost, registered in the console.
VITE_APPCHECK_DEBUG_TOKEN=
# Optional: cloud model for the fallback (default gemini-3.5-flash-lite).
VITE_CLOUD_MODEL=
